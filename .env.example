# Public site URL — canonical tags, hreflang, sitemap and robots.
# Must be the host that actually serves the site, including www if that is the
# canonical form. Set this in the hosting dashboard too: without it a Vercel
# production build has no way to know the custom domain.
NEXT_PUBLIC_SITE_URL=https://www.travlbok.com

# Supabase. Leave empty to run entirely on the bundled dataset in src/data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed for the seed script, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Google AdSense publisher id, e.g. ca-pub-1234567890123456.
# Unset means ad slots render as reserved placeholders (no script loaded).
NEXT_PUBLIC_ADSENSE_CLIENT=
